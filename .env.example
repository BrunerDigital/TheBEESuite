# Integration credentials. Server routes keep secrets out of the browser.
INTEGRATION_CREDENTIALS_SECRET=""
INTEGRATION_OAUTH_STATE_SECRET=""
STRIPE_SECRET_KEY=""
# Preferred: signing secret for the Stripe "Your account" production destination.
STRIPE_PLATFORM_WEBHOOK_SECRET=""
# Legacy compatibility candidate. Do not put a CLI or unrelated endpoint secret here.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Pin Stripe API requests. The default follows the June 24, 2026 preview docs used by the app.
STRIPE_API_VERSION="2026-06-24.preview"
# Stripe Connect platform settings. New schools must complete payout onboarding before parent checkout is enabled.
STRIPE_ACCOUNTS_V2_API_VERSION="2026-06-24.preview"
# Legacy application-fee overrides are ignored; the complete BEE Suite fee is the 1% policy below.
STRIPE_APPLICATION_FEE_BPS="0"
# Legacy fixed application-fee override retained for deployment compatibility.
STRIPE_APPLICATION_FEE_FIXED_CENTS="0"
# Legacy/global parent-paid surcharge. Prefer the fixed card policy below.
STRIPE_PARENT_SURCHARGE_BPS="0"
STRIPE_PARENT_SURCHARGE_FIXED_CENTS="0"
STRIPE_PARENT_SURCHARGE_MAX_CENTS="0"
# Stripe Dashboard payment method configurations used to separate ACH and card checkout flows.
STRIPE_ACH_PAYMENT_METHOD_CONFIGURATION_ID=""
STRIPE_CARD_PAYMENT_METHOD_CONFIGURATION_ID=""
STRIPE_LINK_BANK_PAYMENT_METHOD_CONFIGURATION_ID=""
STRIPE_REQUIRE_PAYMENT_METHOD_CONFIGURATION_FOR_FEES="true"
STRIPE_PARENT_PROCESSING_RECOVERY_APPROVED="false"
# Legacy recovery settings are retained only for compatibility and are ignored by checkout.
STRIPE_CARD_PROCESSING_RECOVERY_BPS="290"
# Legacy parent recovery settings are ignored; schools absorb all Stripe fees.
STRIPE_CARD_PROCESSING_RECOVERY_FIXED_CENTS="0"
STRIPE_CARD_PROCESSING_RECOVERY_GROSS_UP="false"
STRIPE_CARD_PROCESSING_RECOVERY_MAX_CENTS="0"
# School-funded processor allocation. These values match the platform's current
# Stripe pricing and are withheld from connected-account proceeds before payout.
STRIPE_SCHOOL_CARD_PROCESSING_FEE_BPS="210"
STRIPE_SCHOOL_CARD_PROCESSING_FEE_FIXED_CENTS="30"
STRIPE_SCHOOL_CARD_PROCESSING_FEE_MAX_CENTS="0"
STRIPE_SCHOOL_ACH_PROCESSING_FEE_BPS="80"
STRIPE_SCHOOL_ACH_PROCESSING_FEE_FIXED_CENTS="0"
STRIPE_SCHOOL_ACH_PROCESSING_FEE_MAX_CENTS="500"
STRIPE_SCHOOL_LINK_PROCESSING_FEE_BPS="144"
STRIPE_SCHOOL_LINK_PROCESSING_FEE_FIXED_CENTS="0"
STRIPE_SCHOOL_LINK_PROCESSING_FEE_MAX_CENTS="0"
STRIPE_SCHOOL_CARD_PRESENT_PROCESSING_FEE_BPS="270"
STRIPE_SCHOOL_CARD_PRESENT_PROCESSING_FEE_FIXED_CENTS="5"
STRIPE_SCHOOL_CARD_PRESENT_PROCESSING_FEE_MAX_CENTS="0"
# Instant bank verification uses the ACH no-parent-fee policy.
# Platform-wide policy: exactly 1% is retained from every school's payout.
# Legacy fee overrides and waiver lists below are ignored by the application.
STRIPE_PAYMENT_OPS_FEE_BPS="100"
STRIPE_PAYMENT_OPS_FEE_FIXED_CENTS="0"
STRIPE_PAYMENT_OPS_FEE_MAX_CENTS="0"
# Legacy waiver settings retained only for deployment compatibility.
STRIPE_PAYMENT_OPS_FEE_WAIVED_TENANT_SLUGS=""
STRIPE_PAYMENT_OPS_FEE_WAIVED_BRAND_SLUGS=""
STRIPE_PAYMENT_OPS_FEE_WAIVED_NAMES=""
STRIPE_ALLOW_PLATFORM_ONLY_PAYMENTS="false"
STRIPE_REQUIRE_ACTIVE_CONNECTED_ACCOUNT="true"
STRIPE_CHECKOUT_ON_BEHALF_OF="false"
# Kid City USA Enterprises corporate monthly software invoice.
# Amount is active school user count times the per-user amount.
STRIPE_KIDCITY_ENTERPRISES_CUSTOMER_ID=""
STRIPE_KIDCITY_SOFTWARE_FEE_PER_SCHOOL_USER_CENTS="4900"
STRIPE_KIDCITY_SOFTWARE_INVOICE_DAYS_UNTIL_DUE="15"
